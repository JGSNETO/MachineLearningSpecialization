   "source": [
    "# 3. Calculate the cost function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a0c703c3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import NumPy\n",
    "import numpy as np\n",
    "\n",
    "# Training data\n",
    "x = np.array([1, 2, 3, 4])\n",
    "y = np.array([2, 4, 6, 8])\n",
    "\n",
    "# Model parameters\n",
    "w = 2\n",
    "b = 0\n",
    "\n",
    "# Calculate predictions\n",
    "predictions = w * x + b\n",
    "\n",
    "# Calculate squared errors\n",
    "squared_errors = (predictions - y) ** 2\n",
    "\n",
    "# Number of training examples\n",
    "m = len(x)\n",
    "\n",
    "# Calculate the cost\n",
    "cost = np.sum(squared_errors) / (2 * m)\n",
    "\n",
    "# Display the results\n",
    "print(\"Predictions:\", predictions)\n",
    "print(\"Squared errors:\", squared_errors)\n",
    "print(\"Cost:\", cost)"
   ]
  },
